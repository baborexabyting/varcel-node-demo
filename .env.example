# --- Admin login (web panel) -------------------------------------------------
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-password

# Secret used to sign login session cookies (any long random string).
SESSION_SECRET=

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---------
# Web-application OAuth client. The "Google Meet API" must be enabled on the project.
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# --- Slack (optional but recommended) ----------------------------------------
# From https://api.slack.com/apps → Basic Information → Signing Secret.
# When set, requests to /api/slash are verified and anything unsigned gets a 401.
SLACK_SIGNING_SECRET=

# --- Token storage (optional) -------------------------------------------------
# Where the Google access/refresh tokens are persisted.
# Default: ./data/google-tokens.json locally, /tmp/google-tokens.json on Vercel.
# TOKEN_STORE_PATH=

# --- Meet link pool (optional) -------------------------------------------------
# How many Meet links are pre-warmed at startup and kept ready.
# Each slash request dequeues one link and a fresh one is generated in background.
# MEET_CACHE_SIZE=10
